# Environment reference — never commit real values. See AI_INTEGRATION.md.
#
# ── 1. Web app (Next.js, Netlify) ─ public values only; RLS protects the data ───────────────────────────────
# Set in web/.env.local (local) or Netlify → Site configuration → Environment variables (production).
NEXT_PUBLIC_SUPABASE_URL=https://pahzxpileudulljgaciw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The web app never uses a service-role / secret key and never sees any AI key.
#
# ── 2. AI interviewer (Supabase Edge Function "interview-ai") ─ SERVER-SIDE SECRETS ─────────────────────────
# Set in Supabase Dashboard → Edge Functions → Secrets (NOT in Netlify, NOT in the browser, NOT in git).
# Required for Gemini:
GEMINI_API_KEY=
# Optional (defaults shown):
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=gemini                 # gemini | ollama
AI_PROVIDER_POLICY=gemini_paid     # must match an ACTIVE row in ai_provider_policies AND the campaign's ai_provider.
                                   # gemini_paid = key's Google Cloud project has billing enabled (paid tier).
                                   # gemini_free = free tier → public data only → interview data is blocked by design.
ALLOWED_ORIGINS=https://crux-ppi.netlify.app,http://localhost:3000
# Optional local provider (only reachable if the Ollama server is reachable from Supabase's cloud):
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1
#
# Supabase injects SUPABASE_URL, SUPABASE_PUBLISHABLE_KEYS / SUPABASE_SECRET_KEYS (and legacy ANON / SERVICE_ROLE)
# into Edge Functions automatically — do not set them yourself.
