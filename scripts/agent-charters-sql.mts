// Generates supabase/bootstrap/agent_board_setup.sql from supabase/bootstrap/agent_charters.json + the board prompt (PPI-029).
//   node --experimental-strip-types scripts/agent-charters-sql.mts > supabase/bootstrap/agent_board_setup.sql
// CI regenerates it and fails if the committed file differs, so the database can never drift from the charters in git.
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";
import { BOARD_PROMPT_KEY, BOARD_PROMPT_VERSION, BOARD_SCHEMA, BOARD_SYSTEM } from "../supabase/functions/_shared/board.ts";

type Role = { code: string; version: number; title: string; credentials: string; charter: string; category: string };
type Team = { code: string; name: string; sort: number; mission: string; roles?: Role[] };
const src = JSON.parse(readFileSync(new URL("../supabase/bootstrap/agent_charters.json", import.meta.url), "utf8")) as { teams: Team[] };
const sha = (s: string) => createHash("sha256").update(s, "utf8").digest("hex");
const q = (s: string) => {                         // dollar-quote safely
  if (s.includes("$c$")) throw new Error("text contains the $c$ delimiter");
  return `$c$${s}$c$`;
};
const codes = new Set<string>();
for (const t of src.teams) for (const r of t.roles ?? []) {
  if (codes.has(r.code)) throw new Error(`duplicate role ${r.code}`);
  codes.add(r.code);
  if (r.charter.length < 200) throw new Error(`charter too short: ${r.code}`);
  if (r.category !== `team:${t.code}`) throw new Error(`category mismatch: ${r.code}`);
}
const promptHash = sha(BOARD_SYSTEM + JSON.stringify(BOARD_SCHEMA));

const out: string[] = [];
out.push(`-- GENERATED by scripts/agent-charters-sql.mts from supabase/bootstrap/agent_charters.json — do not edit by hand.
-- Expert review board (PPI-029): teams, versioned charters, the board prompt registration. Idempotent; tenants CRUX and E2E-SYNTH.
-- A changed charter must get a new version in the JSON; the old version is retired here, never edited (the DB forbids it).
do $setup$
declare v_co uuid;
begin
  for v_co in select id from public.companies where code in ('CRUX', 'E2E-SYNTH') loop`);
for (const t of src.teams) {
  out.push(`    insert into public.agent_teams (company_id, code, name, mission, sort_order)
    values (v_co, '${t.code}', ${q(t.name)}, ${q(t.mission)}, ${t.sort})
    on conflict (company_id, code) do update set name = excluded.name, mission = excluded.mission, sort_order = excluded.sort_order;`);
  for (const r of t.roles ?? []) {
    out.push(`    update public.agent_roles set status = 'retired' where company_id = v_co and code = '${r.code}' and version <> ${r.version} and status = 'active';
    insert into public.agent_roles (company_id, team_id, code, version, title, credentials, charter, charter_sha256)
    select v_co, t.id, '${r.code}', ${r.version}, ${q(r.title)}, ${q(r.credentials)}, ${q(r.charter)}, '${sha(r.charter)}'
      from public.agent_teams t where t.company_id = v_co and t.code = '${t.code}'
    on conflict (company_id, code, version) do nothing;`);
  }
}
out.push(`    insert into public.prompt_versions (company_id, prompt_key, version, purpose, template_sha256, output_schema, status)
    values (v_co, '${BOARD_PROMPT_KEY}', ${BOARD_PROMPT_VERSION}, 'Expert review board turn: one expert proposes, critiques, consolidates, formats or audits, within its charter and grounded in numbered sources',
            '${promptHash}', '{"see":"supabase/functions/_shared/board.ts BOARD_SCHEMA"}'::jsonb, 'active')
    on conflict (company_id, prompt_key, version) do nothing;
    update public.prompt_versions set status = 'retired' where company_id = v_co and prompt_key = '${BOARD_PROMPT_KEY}' and version < ${BOARD_PROMPT_VERSION} and status = 'active';
  end loop;
end $setup$;`);
console.log(out.join("\n"));
